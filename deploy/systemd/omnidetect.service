[Unit]
Description=OmniDetectCore edge detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omnidetect
Group=omnidetect
WorkingDirectory=/opt/omnidetect
EnvironmentFile=-/etc/omnidetect/camera.env
ExecStart=/opt/omnidetect/bin/omnidetect_edge --config /etc/omnidetect/config.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/omnidetect /var/log/omnidetect
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
